APP_ENV=development
API_PORT=7302

# PostgreSQL / Redis / MinIO 均为本机独立共享服务，不在本仓库的 compose 内定义
# （见 ~/Desktop/postgres、~/Desktop/redis、~/Desktop/minio）
# 5433 而非默认 5432：5432 已被其他项目占用
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/retouch
# 共享 Redis 实例；db 0/1 已被其他项目占用，本项目固定用 db 2
REDIS_URL=redis://localhost:6379/2

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=retouch
S3_URL_TTL=900

# 生产环境必须替换为随机值
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_TTL_HOURS=24

# mock 使用本地占位图，不产生任何调用费用；接真实模型时改为 dashscope
IMAGE_PROVIDER=mock
DASHSCOPE_API_KEY=
TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
IMAGE_EDIT_MODEL=qwen-image-edit-max
PLANNER_MODEL=qwen-plus
